*.iml
.gradle
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
.kotlin/


*.tar.zst

# local agent worktrees (never commit)
.claude/worktrees/

# Samsung Galaxy Performance SDK — proprietary, not GPL, supplied per-build (see
# app/libs/GalaxyPerf/README.md). Never commit the jar; keep the drop-point + docs.
/app/libs/GalaxyPerf/*.jar

# bl-steam-client (Rust): cargo build output and the CI-built cdylib. The .so is produced by
# .github/workflows/_build.yml every run and copied into jniLibs — never commit it.
/app/src/main/cpp/bl-steam-client/rust/target/
/app/src/main/jniLibs/arm64-v8a/libblsteam.so
scratchpad/
# hermes (Rust controller-input transport): cargo output, the loom crate's own lockfile, and the
# CI-built JNI writer copied into jniLibs.
/app/src/main/cpp/hermes/target/
/app/src/main/cpp/hermes/loom/target/
/app/src/main/cpp/hermes/loom/Cargo.lock
/app/src/main/jniLibs/arm64-v8a/libhermes.so
# HERMES-XInput: the CI test feeder's cargo output, and the DLLs + manifest _build.yml builds into
# the assets (app/src/main/cpp/hermes/xinput/build.sh dlls), never committed.
/app/src/main/cpp/hermes/xinput/feeder/target/
/app/src/main/cpp/hermes/xinput/feeder/Cargo.lock
/app/src/main/assets/hermes-xinput/

# dxvk-nvapi dlls: fetched and sha256-checked by _build.yml from the release pinned in
# app/src/main/assets/dxvk-nvapi/manifest.json, never committed.
app/src/main/assets/dxvk-nvapi/*.dll

# Built by CI from app/src/main/cpp/winlator/fakeinput.cpp (glibc aarch64) for the Linux runtime.
app/src/main/assets/linuxfs/libfakeinput.so
app/src/main/assets/linuxfs/libblsession.so
app/src/main/assets/linuxfs/usr/local/bin/
art*/

# Xbox store backend (Xodus) and its Windows modules: built by CI from tools/xbox, never committed.
/app/src/main/assets/xbox/
/app/src/main/jniLibs/arm64-v8a/libxodus_cli.so
/app/src/main/jniLibs/arm64-v8a/libxodus_service.so

# Python bytecode (the release scripts)
__pycache__/
