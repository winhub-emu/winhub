+const SUBSCRIPTION_PLANS: &[&str] = &[
+    "CFQ7TTC0KGQ8", "CFQ7TTC0KHS0", "CFQ7TTC0P85B",
+    "CFQ7TTC0K5DJ", "CFQ7TTC0K6L8", "CFQ7TTC10QFD",
+];
+
+fn subscription_rows(body: &Value) -> Result<Vec<Value>, &'static str> {
+    let rows = body["entitlements"].as_object().ok_or("subscriptions-shape")?;
+    if rows.len() > SUBSCRIPTION_PLANS.len() { return Err("subscriptions-count"); }
+    let mut plans = Vec::new();
+    for (id, row) in rows {
+        if !SUBSCRIPTION_PLANS.contains(&id.as_str()) { return Err("subscriptions-product"); }
+        let status = row["status"].as_str().ok_or("subscriptions-status")?;
+        if status != "Active" { continue; }
+        let expiry = row["endDate"].as_str().filter(|s| s.len() < 50)
+            .filter(|s| chrono::DateTime::parse_from_rfc3339(s).is_ok()).ok_or("subscriptions-expiry")?;
+        plans.push(json!({"productId":id,"status":status,"endDate":expiry}));
+    }
+    Ok(plans)
+}
+
+async fn subscriptions(client: &reqwest::Client, ticket: &str, market: &str) -> Result<Vec<Value>, &'static str> {
+    let url = format!("https://beige.xboxservices.com/PCGAFD/entitlements/subscriptions?market={market}&language=en-US&appVersion=0.2.3");
+    let cv = format!("{}.0", STANDARD_NO_PAD.encode(uuid::Uuid::new_v4().as_bytes()));
+    let mut response = client.post(url)
+        .header("Authorization", ticket).header("X-MS-API-Version", "1.1")
+        .header("Calling-App-Name", "Xodus-Nexus").header("MS-CV", cv)
+        .json(&json!({"productIds":SUBSCRIPTION_PLANS}))
+        .send().await.map_err(|_| "subscriptions-request")?;
+    if !response.status().is_success() {
+        diagnostic("subscriptions-http", response.status().as_u16(), 0);
+        return Err("subscriptions-http");
+    }
+    if response.content_length().is_some_and(|n| n > 262_144) { return Err("subscriptions-size"); }
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| "subscriptions-read")? {
+        if bytes.len() + chunk.len() > 262_144 { return Err("subscriptions-size"); }
+        bytes.extend_from_slice(&chunk);
+    }
+    let body: Value = serde_json::from_slice(&bytes).map_err(|_| "subscriptions-json")?;
+    subscription_rows(&body)
+}
